{
  "name": "eson-web",
  "version": "0.1.0",
  "private": true,
  "description": "ESON personal brand & engineering website (monorepo root)",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:validate": "pnpm --filter backend prisma:validate"
  }
}
