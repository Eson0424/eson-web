# Eson_web environment template
# 复制为 .env 后填入本地值。.env 已被 .gitignore 忽略，禁止提交真实凭据。

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://eson:CHANGE_ME@localhost:5432/eson_web?schema=public
POSTGRES_USER=eson
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eson_web

# ── Authentication (JWT) ───────────────────────────────────
# Access Token 走 Authorization: Bearer，Refresh Token 仅通过 HttpOnly Cookie。
# 生产（NODE_ENV=production）：以下三个 secret 必须由部署环境注入，缺失/空白/使用本模板的
# 占位值都会让 backend 启动失败（fail-fast，Phase 5-C），不会回退到开发默认值。
JWT_SECRET=CHANGE_ME_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_SECRET

# ── Contact / Security ─────────────────────────────────────
# 生产必填（同上）；用于联系表单的 IP 哈希加盐，禁止使用默认值。
CONTACT_IP_SALT=CHANGE_ME_CONTACT_SALT

# ── Admin Bootstrap（Phase 5-D，仅一次性命令使用） ─────────
# 仅 `admin:bootstrap` 读取；应用运行时不需要这两个变量，也不会自动创建管理员。
# 生产必须使用真实值：邮箱不得为 admin@example.com，密码不得少于 12 位。
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 可选：管理员显示名（默认 Admin）
# ADMIN_NAME=

# ── Frontend / API ─────────────────────────────────────────
# 允许的前端来源，多个用逗号分隔（例如 dev 3000 + preview 3124）
CORS_ORIGIN=http://localhost:3000,http://localhost:3124
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Production Edge / HTTPS (Phase 5-F) ────────────────────
# 生产 compose（docker-compose.prod.yml）只强制要求一个域名变量；
# Caddy 配置、CORS_ORIGIN、NUXT_PUBLIC_API_BASE / SITE_URL、MEDIA_PUBLIC_BASE_URL
# 默认都由它派生（需要拆分域名时再显式覆盖对应变量）。
# 本地开发不需要这些变量。
# SITE_DOMAIN=example.com
#
# 仅用于本地 TLS 验证：Caddy 内部 CA（不是生产 HTTPS）。
# 生产部署必须留空 = Caddy automatic HTTPS（Let's Encrypt / ZeroSSL 自动申请 + 续期）。
# CADDY_TLS_DIRECTIVE=tls internal
#
# 仅 SSR 使用的内网 API base（避免经公网入口回环到 Caddy；浏览器仍走公开 HTTPS origin）：
# NUXT_API_BASE_SERVER=http://backend:3001/api/v1
#
# ICP 备案号（Footer 展示，链接到 https://beian.miit.gov.cn/）。
# 生产必须注入真实备案号；留空时 Footer 不渲染备案行（不会出现空占位）。
# 仓库内不写死真实备案号，请只在本机 .env / 生产环境文件中填写。
# NUXT_PUBLIC_ICP_BEIAN=CHANGE_ME_ICP_BEIAN

# ── Object Storage (Local: MinIO / Production: S3-compatible) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eson-web-media
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

# ── MinIO local console ────────────────────────────────────
MINIO_ROOT_USER=eson
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ── Media Storage (Phase 4-F.1 / 生产加固 Phase 5-E) ────────
# local（默认）：backend/.data 作为本地 bucket 根，文件写入 .data/<object-key>
#                  公开 URL = MEDIA_PUBLIC_BASE_URL + /<object-key>（即 /media/<yyyy>/<mm>/<uuid>.<ext>）
# s3：需要上面的 S3_* 配置；S3 驱动在后续阶段实现，当前选择 s3 会 fail-fast（不会伪造上传成功）
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# 可选：覆盖本地 bucket 根目录（默认 <backend>/.data）
# MEDIA_LOCAL_ROOT=
#
# 生产环境（NODE_ENV=production）必须显式提供以下两项，缺失会让 backend 拒绝启动：
#   MEDIA_PUBLIC_BASE_URL=https://<domain>        ← 允许被公网访问的媒体前缀
#   MEDIA_LOCAL_ROOT=/srv/eson-media              ← 必须落在 media-data 卷内，否则容器重建会丢媒体
# 二者都不允许回退到 http://localhost:<port> 或 <backend cwd>/.data（Phase 5-E 起 fail-fast）。
# 生产媒体为本地卷存储（LocalStorageDriver）；对象存储 / CDN / 备份属后续阶段。
