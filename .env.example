# Eson_web environment template
# 复制为 .env 后填入本地值。.env 已被 .gitignore 忽略，禁止提交真实凭据。

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://eson:CHANGE_ME@localhost:5432/eson_web?schema=public
POSTGRES_USER=eson
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eson_web

# ── Authentication (JWT) ───────────────────────────────────
# Access Token 走 Authorization: Bearer，Refresh Token 仅通过 HttpOnly Cookie。
JWT_SECRET=CHANGE_ME_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_SECRET

# ── Frontend / API ─────────────────────────────────────────
# 允许的前端来源，多个用逗号分隔（例如 dev 3000 + preview 3124）
CORS_ORIGIN=http://localhost:3000,http://localhost:3124
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Object Storage (Local: MinIO / Production: S3-compatible) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eson-web-media
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

# ── MinIO local console ────────────────────────────────────
MINIO_ROOT_USER=eson
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ── Media Storage (Phase 4-F.1) ────────────────────────────
# local（默认）：backend/.data 作为本地 bucket 根，文件写入 .data/<object-key>
#                  公开 URL = MEDIA_PUBLIC_BASE_URL + /<object-key>（即 /media/<yyyy>/<mm>/<uuid>.<ext>）
# s3：需要上面的 S3_* 配置；S3 驱动在后续阶段实现，当前选择 s3 会 fail-fast（不会伪造上传成功）
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# 可选：覆盖本地 bucket 根目录（默认 <backend>/.data）
# MEDIA_LOCAL_ROOT=
